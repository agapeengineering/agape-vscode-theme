  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4C533F"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1747A6"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#7E2482"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#902810"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#714300"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#005849"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#3B5915"
      }
    },
    {
      "name": "Language constants and booleans",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#1747A6"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#005468"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#004F87"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1747A6"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#714300"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#202020"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#714300"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#005849"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#9C1028"
      }
    },
    {
      "name": "Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#304628"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#72271F"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#005849",
    "type": "#005849",
    "class": "#005849",
    "enum": "#005849",
    "interface": "#005849",
    "struct": "#005849",
    "typeParameter": "#005849",
    "parameter": "#004F87",
    "variable": "#004F87",
    "property": "#004F87",
    "number": "#3B5915",
    "boolean": "#1747A6",
    "enumMember": "#005468",
    "function": "#714300",
    "method": "#714300",
    "decorator": "#714300",
    "keyword": "#1747A6",
    "modifier": "#1747A6",
    "comment": "#4C533F",
    "string": "#902810",
    "regexp": "#902810",
    "operator": "#202020",
    "*.readonly": {
      "foreground": "#005468"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
