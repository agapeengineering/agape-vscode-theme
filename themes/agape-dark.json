  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7E9F68"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6CAFE0"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#D38BCC"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#DF9B7A"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#E5CE83"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#57C7B0"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#ADC98C"
      }
    },
    {
      "name": "Language constants and booleans",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#6CAFE0"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#65C5EF"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6CAFE0"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E5CE83"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E7D8C0"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#E5CE83"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#57C7B0"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F07878"
      }
    },
    {
      "name": "Emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#C2E09C"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F4AB92"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#57C7B0",
    "type": "#57C7B0",
    "class": "#57C7B0",
    "enum": "#57C7B0",
    "interface": "#57C7B0",
    "struct": "#57C7B0",
    "typeParameter": "#57C7B0",
    "parameter": "#9CDCFE",
    "variable": "#9CDCFE",
    "property": "#9CDCFE",
    "number": "#ADC98C",
    "boolean": "#6CAFE0",
    "enumMember": "#65C5EF",
    "function": "#E5CE83",
    "method": "#E5CE83",
    "decorator": "#E5CE83",
    "keyword": "#6CAFE0",
    "modifier": "#6CAFE0",
    "comment": "#7E9F68",
    "string": "#DF9B7A",
    "regexp": "#DF9B7A",
    "operator": "#E7D8C0",
    "*.readonly": {
      "foreground": "#65C5EF"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
